
var cards_taken = 0
var player_choice = 0
var bot_to_move = false


def arch_get_input(test: Int) Int {

    return 12 - .cards_taken

}

def redraw() {

    let cards_left = 12 - .cards_taken
    let cards_not_raised = cards_left - .player_choice

    if cards_left <= 1 {

        if !.bot_to_move {

            ui_set_text("description", `You lost!`)

        } else {

            ui_set_text("description", `You won!`)

        }

    } else {

        if .bot_to_move {

            ui_set_text("description", `Hit enter to see what the oponent does`)

        } elif .player_choice == 0 {

            ui_set_text("description", `Use the arrow keys to take cards`)

        } else {

            ui_set_text("description", `Hit enter to take {.player_choice} cards`)

        }

    }

    var i = 0

    while i < 12 {

        let name = str(i)
        ui_set_hidden(name, i >= cards_left)

        if i < cards_not_raised {

            ui_set_position(name, -330 + 60 * i, 0)

        } else {

            ui_set_position(name, -330 + 60 * i, -30)

        }


        i += 1

    }

}

def bot_move() {
    
    let cards_left = 12 - .cards_taken
    var bot_action = 0

    switch cards_left
        1  { return }
        2  { bot_action = 1 }
        3  { bot_action = 2 }
        4  { bot_action = 3 }
        5  { bot_action = 1 + random(2) }
        6  { bot_action = 1 }
        7  { bot_action = 2 }
        8  { bot_action = 3 }
        9  { bot_action = 1 + random(2) }
        10 { bot_action = 1 }
        11 { bot_action = 2 }

    .cards_taken += bot_action
    .bot_to_move = false

}

def on_manual_input(action: Int) {

    const #ADD_CARD = 0
    const #REM_CARD = 2
    const #COMMIT   = 5

    let cards_left = 12 - .cards_taken

    if cards_left <= 1 {
    
        return
    
    }
    
    if action != #REM_CARD && action != #ADD_CARD && action != #COMMIT {
        
        return
    
    }

    if .bot_to_move && action != #COMMIT {

        return

    }

    if !.bot_to_move && action == #COMMIT && .player_choice == 0 {

        return

    }

    if action == #ADD_CARD {

        if .player_choice == 3 || .player_choice >= cards_left {

            return

        }

        .player_choice = .player_choice + 1

    } elif action == #REM_CARD {

        if .player_choice <= 1 {

            return

        }

        .player_choice = .player_choice - 1

    } else {

        if .bot_to_move {

            bot_move()

        } else {

            .cards_taken += .player_choice
            .player_choice = 0
            .bot_to_move = true
    
        }

    }

    redraw()

}

def arch_check_output(test: Int, input: Int, output: Int) TestResult {

    let cards_left = 12 - .cards_taken

    if output == 0 || output > 3 {

        set_error("You may only take 1, 2 or 3 cards")
        return fail

    }

    if output >= cards_left {

        .cards_taken = 0
        set_error("You took the last card")
        return fail

    }

    .cards_taken += output
    .bot_to_move = true

    bot_move()
    redraw()

    if .cards_taken == 11 {

        return .bot_to_move ? win : fail

    }

}

