
var input = U8 random(250)

def get_input(tick: Int) Input {

    return Input {input: .input}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let actual_counter = get_output("Count", 0)
    let instruction = get_ram_value("Program", actual_counter, <U8>)

    ui_set_instruction(0, Int instruction, tick)

    if !output.output_enabled {
        return pass
    }

    if input.input + 5 != output.output {
        if !output.output_enabled {
            set_error(`{input.input} + 5 is {input.input + 5}, not Z.`)
        } else {
            set_error(`{input.input} + 5 is {input.input + 5}, not {output.output}.`)
        }
        return fail
    }

    return win
}
