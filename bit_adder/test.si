def get_input(tick: Int) Input {

    return Input {a: U1 tick, b: U1 (tick >> 1)}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    if output.sum_is_z || output.carry_is_z {
        return fail
    }

    if U8 input.a + U8 input.b == U8 output.sum + U8 output.carry * 2 {

        if tick == 3 {

            return win

        }
      
    } else {

        return fail

    }

}