
def get_input(tick: Int) Input {

    var x = tick
    x ^= x << 7
    x ^= x >> 9
    x ^= x << 8

    return Input {a: U8 x, b: U8 (x >> 8)}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let expected = input.a == input.b
    let actual   = output.result != 0

    ui_set_text("description", `{input.a} == {input.b}  is  {expected ? "[ON]" : "[OFF]"}`)

    if expected == actual {

        if tick == 0xffff {
            return win
        }

    } else {

        set_error(`The value {input.a} is{expected ? "" : " not"} equal to {input.b}`)
        return fail

    }

}
