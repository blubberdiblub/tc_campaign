
def get_input(tick: Int) Input {

    var x = tick
    x ^= x << 7
    x ^= x >> 9
    x ^= x << 8

    return Input {a: U8 x, b: U8 (x >> 8)}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let expected = input.a == input.b
    let actual   = output.result != 0

    let a = input.a
    let b = input.b
    let value = expected ? "[ON]" : "[OFF]"

    ui_set_text("description", (31337_18508994046371, `{a} == {b} is {value}`))

    if expected == actual {

        if tick == 0xffff {
            return win
        }

    } else {

        if expected {
            set_error((31337_51276780017906, `The value {a} is equal to {b}`))
        } else {
            set_error((31337_32432328437519, `The value {a} is not equal to {b}`))
        }

        return fail

    }

}
