
def get_input(tick: Int) Input {

    var x = tick
    x ^= x << 7
    x ^= x >> 9
    x ^= x << 8
    return Input {a: U8 x, b: U8 (x >> 8)}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let expected = (S8 input.a < S8 input.b)
    let actual = (output.result != 0)

    let a = S8 input.a
    let b = S8 input.b
    let result = expected ? "[ON]" : "[OFF]"
    ui_set_text("description", (31337_67770115019509, `{a} < {b} is {result}`))

    if expected == actual {

        if tick == 0xffff { 
            return win
        }

    } else {

        if expected {
            set_error((31337_60636366241019, `The value {a} is less than {b}`))
        } else {
            set_error((31337_18672872329218, `The value {a} is not less than {b}`))
        }
        return fail

    }
}

