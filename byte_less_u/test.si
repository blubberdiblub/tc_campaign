
def get_input(cycle: Int) Input {

    var x = cycle
    x ^= x << 7
    x ^= x >> 9
    x ^= x << 8
    return Input {a: U8 x, b: U8 (x >> 8)}

}

def check_output(cycle: Int, input: Input, output: Output) TestResult {

    let expected = (U8 input.a < U8 input.b)
    let actual = (output.result != 0)

    let a = U8 input.a
    let b = U8 input.b
    let value = expected ? "[T]" : "[F]"

    ui_set_text("description", (31337_75551771019196, `{a} < {b} is {value}`))

    if output.result_is_z {
        set_error((31337_33181499064044, `Result should never be Z state`))
        return fail
    }

    if expected == actual {

        if cycle == 0xffff {
            return win
        }

    } else {

        if expected {
            set_error((31337_54835419299907, `The value {a} is less than {b}`))
        } else {
            set_error((31337_50702714470018, `The value {a} is not less than {b}`))
        }
        return fail

    }
}
