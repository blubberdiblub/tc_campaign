
def get_input(tick: Int) Input {

    var x = tick
    x ^= x << 7
    x ^= x >> 9
    x ^= x << 8
    return Input {a: U8 x, b: U8 (x >> 8)}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let expected = (U8 input.a < U8 input.b)
    let actual = (output.result != 0)

    ui_set_text("description", `{U8 input.a} < {U8 input.b}  is  {expected ? "[ON]" : "[OFF]"}`)

    if expected == actual {

        if tick == 0xffff { 
            return win
        }

    } else {

        set_error(`The value {U8 input.a} is{expected ? "" : " not"} less than {U8 input.b}`)
        return fail

    }
}
