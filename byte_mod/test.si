
def get_input(tick: Int) Input {

    var x = tick + 0xffb0
    x ^= x << 7
    x ^= x >> 9
    x ^= x << 8

    return Input {a: U8 (x >> 8), b: U8 x}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let result = input.a % input.b

    let a = input.a
    let b = input.b
    let description = (31337_38641362389638, `{a} mod {b} is {result}`)

    ui_set_text("description", description)

    if output.result_is_z {
        set_error((31337_33181499064044, `Result should never be Z state`))
        return fail
    }

    if result & 0xff != output.result & 0xff {
        set_error(description)
        return fail
    }

    if tick == 0xffff {
        return win
    }

}