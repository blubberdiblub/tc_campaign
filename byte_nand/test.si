def get_binary_repr(value: Int) String {
    var text = ""
    var i = 7
    while i >= 0 {
        if ((value >> i) & 1) == 0 {
            text += "[OFF]"
        } else {
            text += "[ON]"
        }
        i -= 1
    }
    return text
}

def get_input(tick: Int) Input {

    var x = tick
    x ^= x << 7
    x ^= x >> 9
    x ^= x << 8

    let input = Input {
        a: U8 x & 0xff, 
        b: U8 (x >> 8)
    }

    ui_set_text("table[0][1]", `{input.a}`)
    ui_set_text("table[0][2]", get_binary_repr(Int input.a))

    ui_set_text("table[1][1]", `{input.b}`)
    ui_set_text("table[1][2]", get_binary_repr(Int input.b))

    let value = Int ~(input.a & input.b)
    ui_set_text("table[2][1]", `{value}`)
    ui_set_text("table[2][2]", get_binary_repr(value))

    return input

}

def check_output(tick: Int, input: Input, output: Output) TestResult {
    
    ui_set_text("table[3][1]", `{output.output}`)
    ui_set_text("table[3][2]", get_binary_repr(Int output.output))

    if ~(input.a & input.b) & 0xff != output.output {
    
        return fail
    
    }
    
    if tick == 0xffff { 
    
        return win
    
    }

}