
def get_input(tick: Int) Input {

    var x = tick
    x ^= x << 7
    x ^= x >> 9
    x ^= x << 8

    return Input {a: U8 x, b: U8 (x >> 8)}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let result = input.a ^ input.b

    ui_set_text("description", `{input.a} XOR {input.b}  is  {result}`)

    if result != output.result {
        set_error(`0x{hex(2, Int input.a)} XOR 0x{hex(2, Int input.b)}  is  0x{hex(2, Int result)}`)
        return fail
    }

    if tick == 0xffff { 
        return win
    }

}