
var input_cursor = 0
var output_cursor = 0
var text_len = 0

var text = ""

switch get_test()
    0 { text = "Computable numbers are the real numbers whose expressions as a decimal are calculable by finite means" }
    1 { text = "The fundamental problem of communication is that of reproducing at one point a message selected at another point" }
    2 { text = "Future users of large data banks must be protected from having to know how the data is organized in the machine" }

ui_set_text("text", text)

def arch_get_input(test: Int) Int {

    let cursor = .input_cursor
    .input_cursor += 1

    let len = .text.len()

    var bg = ""
    var i = 0
    while i < len {
        if i == cursor {
            bg += "█"
        } else {
            bg += " "
        }
        i += 1
    }

    ui_set_text("bg", `{bg}`)

    return Int .text[cursor]

}

def arch_check_output(test: Int, input: Int, output: Int) TestResult {
    var mask = U8 0b11011111

    if .output_cursor > .input_cursor {
        set_error(`You did not read character {.output_cursor} from the string yet`)
        return fail
    }

    var char = U8 .text[.output_cursor]
    if .output_cursor == 0 {
        char &= mask // Capitalize first char
    } elif .text[.output_cursor - 1] == Char 32 {
        char &= mask // Capitalize
    }

    if U8 output != char {
        set_error(`Output should have been {char}, not {output}`)
        return fail
    }

    .output_cursor += 1
    if .output_cursor == .text.len() {
        return win
    }
}