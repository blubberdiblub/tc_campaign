

ui_set_hidden("note", true)

var size = random(41) + 1

def arch_get_input(test: Int) Int {

    ui_set_text("goal", `What is 2π × {.size}?`)
    ui_set_hidden("note", false)

    return .size
}

def arch_check_output(test: Int, input: Int, output: Int) TestResult {

    print_using_stack(output)

    if output != .size * 6 {
        set_error(`2π × {.size} ≈ {.size * 6}`)
        return fail
    }

    return win

}