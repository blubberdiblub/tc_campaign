
var count = 0
var seen = 0

def arch_get_input(test: Int) Int {
    if .seen == 1{
        return 37
    }

    .count += 1

    var value = random(256)
    if .count >= 255 {
        value = 37
    }

    if value == 37 {
        .seen = 1
    }

    return value
}

def arch_check_output(test: Int, input: Int, output: Int) TestResult {

    if input != 37 {
        set_error(`最后一次输入值不是 37！`)
        return fail    
    }

    if output != .count {
        set_error(`你共读取了 {.count} 次输入，但期望次数是 {output}。`)
        return fail
    }
    return win
}
