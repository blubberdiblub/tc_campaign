
var count = 0
var seen = 0

def arch_get_input() Int {
    if .seen == 1{
        return 37
    }

    .count += 1

    var value = random(256)
    if .count >= 255 {
        value = 37
    }

    if value == 37 {
        .seen = 1
    }

    return value
}

def arch_check_output(output: Int) TestResult {

    if .seen == 37 {
        set_error((31337_39953782121467, `The last input was not 37!`))
        return fail    
    }

    if output != .count {
        let read_count = .count
        set_error((31337_75138288162938, `You read the input {read_count} times, not {output}.`))
        return fail
    }
    return win
}