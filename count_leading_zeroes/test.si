
def get_input(tick: Int) Input {

    return Input {input: U8 tick}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let count = clz(input.input) - 56
    
    if count != output.result {

        if output.result_is_z {

            set_error(`Output should never be Z state`)

        } elif count == 1 {

            set_error(`There is 1 leading zero in {input.input} (0b{bin(8, Int input.input)})`)

        } else {

            set_error(`There are {count} leading zeroes in {input.input} (0b{bin(8, Int input.input)})`)

        }

        return fail

    }


    if tick == 0x100 {

        return win

    }

}