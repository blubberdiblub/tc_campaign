const #CORRECT_OUTPUT = [U3 0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 4]

def get_input(tick: Int) Input {

    return Input {input: U4 tick}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    var display_result = str(output.output)

    ui_set_text(`table[5][{tick + 1}]`, display_result)

    if #CORRECT_OUTPUT[tick] != output.output {
        return fail
    }

    if tick == #CORRECT_OUTPUT.len() - 1 {
        return win
    }

}