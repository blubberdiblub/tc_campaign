
def get_input(tick: Int) Input {

    return Input {input: U1 tick}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {
  
    switch tick
        0 {

            if output.output != 1 {

                return fail

            } 

        }

        1 {

            if output.output != 2 {

                return fail

            } 

            return win

        }

}