def get_input(tick: Int) Input {

    return Input {input: U3 tick, disable: U1 (tick >> 3)}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    var value = Int output.output

    if input.disable == 1 {
        if value != 0 {

            set_error((31337_18073111523064, `Expected all outputs to be OFF since the disable bit is ON`))
            return fail

        }

    } elif value != 1 << tick {

        set_error((31337_10870388349665, `Expected output {tick} to be ON and other outputs to be OFF`))
        return fail

    }


    if tick == 15 {

        return win

    }

}