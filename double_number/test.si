def get_binary_repr(value: U8, size: U8) String {
    var text = ""
    var i = size
    while i > 0 {
        i -= 1
        if ((value >> i) & 1) == 0 {
            text += "[OFF]"
        } else {
            text += "[ON]"
        }
    }
    return text
}

def get_padded_number(value: String, size: Int) String {
    var text = value
    while text.len() < size {
        text = " " + text
    }
    return "[right]" + text + "[/right]"
}

def get_input(tick: Int) Input {
    let input = U8 random(128)
    ui_set_text("table[0][1]", get_padded_number(str(input), 3))
    ui_set_text("table[0][2]", get_binary_repr(input, U8 8))
    return Input {input: input}
}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let expected = input.input * 2
    ui_set_text("table[1][1]", get_padded_number(str(expected), 3))
    ui_set_text("table[1][2]", get_binary_repr(expected, U8 8))
    ui_set_text("table[2][1]", get_padded_number(str(output.output), 3))
    ui_set_text("table[2][2]", get_binary_repr(output.output, U8 8))

    if expected != output.output {
        return fail
    }
    
    if tick == 15 { 
        return win
    }

}