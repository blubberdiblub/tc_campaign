
def get_input(tick: Int) Input {

    return Input {input_0: U1 tick, input_1: U1 (tick >> 1), input_2: U1 (tick >> 2) }

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    if output.sum_is_z || output.carry_is_z {
        return fail
    }

    let actual_sum = U8 input.input_0 + U8 input.input_1 + U8 input.input_2
    let given_sum = (U8 output.sum) + (U8 output.carry << U8 1)

    if U8 actual_sum == given_sum {
      
        if tick == 7 { 

            return win 

        }
    
    } else {

        return fail

    }

}

