
var actual_input = random(256)

def arch_get_input(test: Int) Int {
    return .actual_input
}

def arch_check_output(test: Int, input: Int, output: Int) TestResult {

    if input == -1 {
        set_error(`请先读取输入。`)
        return fail
    }

    if output != .actual_input % 4 {
        set_error(`{.actual_input} 除以 4 的余数应为 {.actual_input % 4}。`)
        return fail
    }

    if get_tick() > 8 {

        set_error(`你最迟在第 8 刻就必须输出结果！`)
        return fail

    }

    return win

}
