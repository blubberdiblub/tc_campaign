
var actual_input = random(256)

def arch_get_input(test: Int) Int {
    return .actual_input
}

def arch_check_output(test: Int, input: Int, output: Int) TestResult {

    if input == -1 {
        set_error((31337_59240995307159, `Request the input first.`))
        return fail
    }

    if output != .actual_input % 4 {
        let inp = .actual_input
        let result = .actual_input % 4
        set_error((31337_60992625993288, `{inp} mod 4 is {result}.`))
        return fail
    }

    if get_tick() > 8 {

        set_error((31337_13853243145042, `You must output the result before tick 8!`))
        return fail

    }

    return win

}