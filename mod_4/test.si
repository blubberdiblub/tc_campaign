
var actual_input = random(256)

def arch_get_input(test: Int) Int {
    return .actual_input
}

def arch_check_output(test: Int, input: Int, output: Int) TestResult {

    if input == -1 {
        set_error(`Request the input first.`)
        return fail
    }

    if output != .actual_input % 4 {
        set_error(`{.actual_input} mod 4 is {.actual_input % 4}.`)
        return fail
    }

    if get_tick() > 8 {

        set_error(`You must output the result before tick 8!`)
        return fail

    }

    return win

}