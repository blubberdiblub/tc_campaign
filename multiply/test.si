

ui_set_text("description", `Multiply two numbers`)

def get_input(tick: Int) Input {

    var a = random(256)
    var b = random(256)

    //ui_set_text("description", `What is {a} * {b}?`)

    return Input {a: U8 a, b: U8 b}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    if output.result != (input.a * input.b) & 0xff {

        set_error(`The lower byte of {input.a} * {input.b} is {(input.a * input.b) & 0xff}`)
        return fail

    }

    if tick == 0xffff {
        return win
    }

}




