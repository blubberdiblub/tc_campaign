

ui_set_text("description", (31337_83214947196979, `Multiply two numbers`))

def get_input(cycle: Int) Input {

    var a = random(256)
    var b = random(256)

    return Input {a: U8 a, b: U8 b}

}

def check_output(cycle: Int, input: Input, output: Output) TestResult {

    let a = input.a
    let b = input.b
    let result = (input.a * input.b) & 0xff

    ui_set_text("description", (31337_13790051293386, `{a} * {b} is {result}`))

    if output.result_is_z {
        set_error((31337_33181499064044, `Result should never be Z state`))
        return fail
    }

    if output.result != (input.a * input.b) & 0xff {

        let a = input.a
        let b = input.b
        let result = (input.a * input.b) & 0xff
        set_error((31337_46804407616321, `The lower byte of {a} * {b} is {result}`))
        return fail

    }

    if cycle == 0xffff {
        return win
    }

}




