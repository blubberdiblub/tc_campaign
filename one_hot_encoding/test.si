def get_input(tick: Int) Input {

    return Input {input: U3 tick}

}


def check_output(tick: Int, input: Input, output: Output) TestResult {

    if get_component_count() > 5 {

        set_error((31337_60812617177494, `Do not use more than 3 components.`))
        return fail

    }

    if output.output_is_z {
        set_error((31337_70376380014778, `Output should never be Z state`))
        return fail
    }

    let expected = 1 << tick
    // Find difference between expected result and actual output by xoring. If they are the same the result should be 0
    let result = expected ^ Int output.output

    // If counting leading zeroes is not 64, it gives us the index of the first mistake
    let zeroes = clz(result)

    if zeroes != 64 {

        let pin = 64 - zeroes
        set_error((31337_74562193652628, `The output on pin {pin} is wrong.`))
        return fail

    }

    if tick == 7 {

        return win

    }

}