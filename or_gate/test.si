const #CORRECT_OUTPUT = [U1 0,1,1,1]

def get_input(tick: Int) Input {
    return Input {input: U2 tick}
}

def check_output(tick: Int, input: Input, output: Output) TestResult {
    if #CORRECT_OUTPUT[tick] != output.output {
        return fail
    }
    if tick == #CORRECT_OUTPUT.len() - 1 {
        return win
    }

}
