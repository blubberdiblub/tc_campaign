[settings]
name = "Overture"

[fields]

in_register
r0 000
r1 001
r2 010
r3 011
r4 100
r5 101
in 110

out_register
r0 000
r1 001
r2 010
r3 011
r4 100
r5 101
out 110

[instructions]

mov %a(out_register), %b(in_register)
10bbbaaa
# Пересылка значения %b в %a.

imm %a(immediate | label)
00aaaaaa
# Загрузка константы %a в r0.

nand
01000000
# И-НЕ(NAND) над r1 и r2, результат сохраняет в r3.

or
01000001
# ИЛИ(OR) над r1 и r2, результат сохраняет в r3.

and
01000010
# И(AND) над r1 и r2, результат сохраняет в r3.

nor
01000011
# ИЛИ-НЕ(NOR) над r1 и r2, результат сохраняет в r3.

add
01000100
# Складывает r1 и r2, результат сохраняет в r3.

sub
01000101
# Вычитает r2 из r1, результат сохраняет в r3.

nop
11000000
# Ничего не делает.

jmp
11000001
# Переход на адрес в r0.

jz
11000010
# Переход на адрес в r0, если r3 равен 0.

jnz
11000011
# Переход на адрес в r0, если r3 не равен 0.

jl
11000100
# Переход на адрес в r0, если r3 меньше 0.

jge
11000101
# Переход на адрес в r0, если r3 больше или равен 0.

jle
11000110
# Переход на адрес в r0, если r3 меньше или равен 0.

jg
11000111
# Переход на адрес в r0, если r3 больше 0.
