const #INPUT  = U8 0b110_000
const #OUTPUT = U8 0b000_110

const #IMM    = U8 0b0000_0000
const #CALC   = U8 0b0100_0000
const #MOVE   = U8 0b1000_0000
const #COND   = U8 0b1100_0000

const #NAND = U8 0
const #OR   = U8 1
const #AND  = U8 2
const #NOR  = U8 3
const #ADD  = U8 4
const #SUB  = U8 5

var registers = [U8 0,0,0,0,0,0]


var push_index = 0

def ram_push(value: U8) {
    set_ram_value("Program", .push_index, value)
    .push_index += 1
}


var h = 0
while h < 6 {
    registers[h] = 0
    h += 1
}

var s = U8 0
var d = U8 0
ram_push(#MOVE | #INPUT | #OUTPUT)
ram_push(#MOVE | #INPUT | 0)
ram_push(#MOVE | #INPUT | 1)
ram_push(#MOVE | #INPUT | 2)
ram_push(#MOVE | #INPUT | 3)
ram_push(#MOVE | #INPUT | 4)
ram_push(#MOVE | #INPUT | 5)

while s <= 6 {
    d = 0
    ram_push(#MOVE | #INPUT | s)
    while d <= 6 {
        ram_push(#MOVE | (s << 3) | d)
        d += 1
    }
    s += 1
}


def get_input(cycle: Int) Input {
    return Input {input: U8 random(256)}
}

def check_output(cycle: Int, input: Input, output: Output) TestResult {

    if get_memory("Count") != cycle + 1 {
        let expected_value = cycle + 1
        set_error((31337_73023200204536, `Counter should have value {expected_value}.`))
        return fail
    }

    let instruction = get_ram_value("Program", cycle, <U8>)

    ui_set_instruction(0, Int instruction, cycle)

    let opcode = U8 (instruction >> 6)

    let to = (instruction >> 3) & 0b111

    if output.output_enabled && (opcode != #MOVE >> 6 || to != 6) {
        set_error((31337_19443898128380, `Output should not be enabled.`))
        return fail
    }

    switch opcode << 6
        #IMM {
            .registers[0] = instruction & 0b111111
        }
        #CALC {
            let alu_code = instruction & 0b111
            let r1 = .registers[1]
            let r2 = .registers[2]

            switch U8 alu_code
                #OR {
                    .registers[3] = r1 | r2
                }
                #NAND {
                    .registers[3] = ~(r1 & r2) & 0xff
                }
                #NOR {
                    .registers[3] = ~(r1 | r2) & 0xff
                }
                #AND {
                    .registers[3] = r1 & r2
                }
                #ADD {
                    .registers[3] = (r1 + r2) & 0xff
                }
                #SUB {
                    .registers[3] = (r1 - r2) & 0xff
                }

        }
        #MOVE {

            let from = instruction & 0b111
            let to   = (instruction >> 3) & 0b111

            var value = U8 0
            if from <= 5 {
                value = .registers[from]
            } elif from == 6 {
                value = U8 input.input
            }

            if to <= 5 {
                .registers[to] = value
            } elif to == 6 {
                if !output.output_enabled {
                    set_error((31337_50052313044113, `Output not enabled.`))
                    return fail
                }
                if output.output != U8 value {
                    set_error((31337_88140381331491, `Expected output: {value}.`))
                    return fail
                }
            }
        }

    var reg_i = 0
    while reg_i < 6 {
        let value = U8 get_memory(`Reg {reg_i}`)
        if .registers[reg_i] != value {
            let value = .registers[reg_i]
            set_error((31337_49097812105667, `Register {reg_i} should have value {value}.`))
            return fail
        }

        reg_i += 1
    }

    if cycle == .push_index - 1 {
        return win
    }
}
