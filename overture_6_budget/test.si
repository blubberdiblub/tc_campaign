var seed = U8 1
var output_index = 0

def get_input(tick: Int) Input {
    return Input {input: U8 .seed}
}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    if input.input_enabled {
        .seed ^= .seed << 6
        .seed ^= .seed >> 5
        .seed ^= .seed << 7
    }

    if !output.output_enabled {
        return pass
    }

    if output.output != #OUTPUTS[.output_index] {
        set_error(`Output should have been {#OUTPUTS[.output_index]}, not {output.output}`)
        return fail
    }

    .output_index += 1

    if .output_index == #OUTPUTS.len() {
        return win
    }
}
