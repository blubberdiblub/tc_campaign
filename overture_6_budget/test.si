var outputs = [U8] []

switch get_test()
    0 { outputs = #OUTPUTS_0 }
    1 { outputs = #OUTPUTS_1 }
    2 { outputs = #OUTPUTS_2 }
    3 { outputs = #OUTPUTS_3 }
    4 { outputs = #OUTPUTS_4 }
    5 { outputs = #OUTPUTS_5 }
    6 { outputs = #OUTPUTS_6 }
    7 { outputs = #OUTPUTS_7 }
    8 { outputs = #OUTPUTS_8 }
    9 { outputs = #OUTPUTS_9 }
    10 { outputs = #OUTPUTS_10 }
    11 { outputs = #OUTPUTS_11 }
    12 { outputs = #OUTPUTS_12 }
    13 { outputs = #OUTPUTS_13 }
    14 { outputs = #OUTPUTS_14 }
    15 { outputs = #OUTPUTS_15 }

var output_index = 0
var input_index  = 0

def rng(input: Int) Int {
    var seed = input
    seed ^= seed << 6
    seed ^= seed >> 5
    seed ^= seed << 7
    seed = seed & 0xff
    return seed
}

def get_input_switched() Int {
    .input_index += 1
    return rng(.input_index)
}

def check_output_switched(value: Int) TestResult {
    if U8 value != .outputs[.output_index] {
        set_error(`Output should be {.outputs[.output_index]}`)
        return fail
    }
    .output_index += 1
    if .output_index >= .outputs.len() {
        return win
    }
}

const #IMM    = U8 0b0000_0000
const #CALC   = U8 0b0100_0000
const #MOVE   = U8 0b1000_0000
const #COND   = U8 0b1100_0000

const #NAND = U8 0
const #OR   = U8 1
const #AND  = U8 2
const #NOR  = U8 3
const #ADD  = U8 4
const #SUB  = U8 5

const #NEVER  = U8 0
const #ALWAYS = U8 1
const #EQ     = U8 2
const #NE     = U8 3
const #LT     = U8 4
const #GE     = U8 5
const #LE     = U8 6
const #GT     = U8 7

const #NOP   = #COND | #NEVER

var counter = U8 0
var registers = array(<U8>, 6)
var emulator_input_index = 0

def retire_instruction(instruction: U8) {

    let opcode = instruction >> 6

    let to = (instruction >> 3) & 0b111
    
    switch U8 opcode
        #IMM {
            .registers[0] = instruction
            .counter += 1
        }
        #CALC >> 6 {
            let alu_code = instruction & 0b111
            let r1 = .registers[1]
            let r2 = .registers[2]

            switch U8 alu_code
                #OR {
                    .registers[3] = r1 | r2
                }
                #NAND {
                    .registers[3] = ~(r1 & r2) & 0xff
                }
                #NOR {
                    .registers[3] = ~(r1 | r2) & 0xff
                }
                #AND {
                    .registers[3] = r1 & r2
                }
                #ADD {
                    .registers[3] = (r1 + r2) & 0xff
                }
                #SUB {
                    .registers[3] = (r1 - r2) & 0xff
                }

            .counter += 1

        }
        #MOVE >> 6 {

            let from = instruction & 0b111
            let to   = (instruction >> 3) & 0b111

            var value = U8 0
            if from <= 5 {
                value = .registers[from]
            } elif from == 6 {
                .emulator_input_index += 1
                value = U8 rng(.emulator_input_index)
            }

            if to <= 5 {
                .registers[to] = value
            }

            .counter += 1
        }
        #COND >> 6 {
            let cond = instruction & 0b111

            let equal = .registers[3] == 0
            let less  = .registers[3] > 127

            var set_counter = false

            switch U8 cond
                #NEVER {}
                #ALWAYS {
                    set_counter = true
                }
                #EQ {
                    set_counter = equal
                }
                #NE {
                    set_counter = !equal
                }
                #LT {
                    set_counter = less
                }
                #GE {
                    set_counter = !less
                }
                #LE {
                    set_counter = less || equal
                }
                #GT {
                    set_counter = !less && !equal
                }

            
            if set_counter {
                .counter = .registers[0]
            } else {
                .counter += 1
            }
        }    
}

def check_output(tick: Int, input: Input, output: Output) TestResult {


    var i = 0
    while i < Int output.donecount {
        let instruction = get_ram_value("Program", Int .counter, <U8>)
        ui_set_instruction(0, Int instruction, tick) // Show the last executed instruction
        retire_instruction(instruction)
        i += 1
    }

    ui_set_text("state[0][1]", str(.counter))
    ui_set_text("state[1][1]", str(.registers[0]))
    ui_set_text("state[1][3]", str(.registers[1]))
    ui_set_text("state[2][1]", str(.registers[2]))
    ui_set_text("state[2][3]", str(.registers[3]))
    ui_set_text("state[3][1]", str(.registers[4]))
    ui_set_text("state[3][3]", str(.registers[5]))

}
