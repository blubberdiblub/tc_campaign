    case 225 { outputs = #OUTPUTS_225 }
    case 226 { outputs = #OUTPUTS_226 }
    case 227 { outputs = #OUTPUTS_227 }
    case 228 { outputs = #OUTPUTS_228 }
    case 229 { outputs = #OUTPUTS_229 }
    case 230 { outputs = #OUTPUTS_230 }
    case 231 { outputs = #OUTPUTS_231 }
    case 232 { outputs = #OUTPUTS_232 }
    case 233 { outputs = #OUTPUTS_233 }
    case 234 { outputs = #OUTPUTS_234 }
    case 235 { outputs = #OUTPUTS_235 }
    case 236 { outputs = #OUTPUTS_236 }
    case 237 { outputs = #OUTPUTS_237 }
    case 238 { outputs = #OUTPUTS_238 }
    case 239 { outputs = #OUTPUTS_239 }
    case 240 { outputs = #OUTPUTS_240 }
    case 241 { outputs = #OUTPUTS_241 }
    case 242 { outputs = #OUTPUTS_242 }
    case 243 { outputs = #OUTPUTS_243 }
    case 244 { outputs = #OUTPUTS_244 }
    case 245 { outputs = #OUTPUTS_245 }
    case 246 { outputs = #OUTPUTS_246 }
    case 247 { outputs = #OUTPUTS_247 }
    case 248 { outputs = #OUTPUTS_248 }
    case 249 { outputs = #OUTPUTS_249 }
    case 250 { outputs = #OUTPUTS_250 }
    case 251 { outputs = #OUTPUTS_251 }
    case 252 { outputs = #OUTPUTS_252 }
    case 253 { outputs = #OUTPUTS_253 }
    case 254 { outputs = #OUTPUTS_254 }
    case 255 { outputs = #OUTPUTS_255 }

var output_index = 0
var input_index  = 0

def rng(input: Int) Int {
    var seed = input
    seed ^= seed << 6
    seed ^= seed >> 5
    seed ^= seed << 7
    seed = seed & 0xff
    return seed
}

def get_input_switched() Int {
    input_index += 1
    return rng(input_index)
}

def check_output_switched(value: Int) TestResult {
    if U8 value != outputs[output_index] {
        set_error(`Output should be {outputs[output_index]}`)
        return fail
    }
    output_index += 1
    if output_index >= outputs.len() {
        return win
    }
}

const #IMM    = U8 0b0000_0000
const #CALC   = U8 0b0100_0000
const #MOVE   = U8 0b1000_0000
const #COND   = U8 0b1100_0000

const #NAND = U8 0
const #OR   = U8 1
const #AND  = U8 2
const #NOR  = U8 3
const #ADD  = U8 4
const #SUB  = U8 5

const #NEVER  = U8 0
const #ALWAYS = U8 1
const #EQ     = U8 2
const #NE     = U8 3
const #LT     = U8 4
const #GE     = U8 5
const #LE     = U8 6
const #GT     = U8 7

const #NOP   = #COND | #NEVER

var counter = U8 0
var registers = array(<U8>, 6)
var emulator_input_index = 0

def retire_instruction(instruction: U8) None {

    let opcode = instruction >> 6

    let to = (instruction >> 3) & 0b111

    switch U8 opcode
        case #IMM {
            registers[0] = instruction
            counter += 1
        }
        case #CALC >> 6 {
            let alu_code = instruction & 0b111
            let r1 = registers[1]
            let r2 = registers[2]

            switch U8 alu_code
                case #OR {
                    registers[3] = r1 | r2
                }
                case #NAND {
                    registers[3] = ~(r1 & r2) & 0xff
                }
                case #NOR {
                    registers[3] = ~(r1 | r2) & 0xff
                }
                case #AND {
                    registers[3] = r1 & r2
                }
                case #ADD {
                    registers[3] = (r1 + r2) & 0xff
                }
                case #SUB {
                    registers[3] = (r1 - r2) & 0xff
                }

            counter += 1

        }
        case #MOVE >> 6 {

            let from = instruction & 0b111
            let to   = (instruction >> 3) & 0b111

            var value = U8 0
            if from <= 5 {
                value = registers[from]
            } elif from == 6 {
                emulator_input_index += 1
                value = U8 rng(emulator_input_index)
            }

            if to <= 5 {
                registers[to] = value
            }

            counter += 1
        }
        case #COND >> 6 {
            let cond = instruction & 0b111

            let equal = registers[3] == 0
            let less  = registers[3] > 127

            var set_counter = false

            switch U8 cond
                case #NEVER {}
                case #ALWAYS {
                    set_counter = true
                }
                case #EQ {
                    set_counter = equal
                }
                case #NE {
                    set_counter = !equal
                }
                case #LT {
                    set_counter = less
                }
                case #GE {
                    set_counter = !less
                }
                case #LE {
                    set_counter = less || equal
                }
                case #GT {
                    set_counter = !less && !equal
                }


            if set_counter {
                counter = registers[0]
            } else {
                counter += 1
            }
        }
}

def check_output(cycle: Int, input: Input, output: Output) TestResult {

    if output.donecount == 0 {
        return pass
    }


    var i = 0
    while i < Int output.donecount {
        let instruction = get_ram_value("Program", Int counter, <U8>)
        ui_set_instruction(0, Int instruction, cycle) // Show the last executed instruction
        retire_instruction(instruction)
        i += 1
    }

    if emulator_input_index != 0 && emulator_input_index != input_index {
        set_error((31337_12247196564353, `You have read {input_index} inputs, but you were supposed to have read {emulator_input_index}.`))
        return fail
    }

    var reg_i = 0
    while reg_i < 6 {
        let value = U8 get_memory(`r{reg_i}`)
        if registers[reg_i] != value {
            let value = registers[reg_i]
            set_error((31337_35224907301551, `Register {reg_i} should have value {value}.`))
            return fail
        }

        reg_i += 1
    }

    if U8 get_memory("Counter") != counter {
        let expected_value = counter
        set_error((31337_24524168624111, `Counter memory should be {expected_value}.`))
        return fail
    }


}
