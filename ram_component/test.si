
var memory_state      = [0,0,0,0]

def markup(text: String) String {
    return `[color=#E5787D][b]{text}[/b][/color]`
}

def get_input(tick: Int) Input {

    var add_1 = random(2)
    var add_2 = random(2)
    var actions = random(4)
    var load = actions & 1
    var save = actions >> 1
    var value = 1 + random(255)
    
    if tick < 8 {
        if tick % 2 == 0 {
            save = 1
            load = 0
            add_1 = (tick / 2) & 1
            add_2 = Int ((tick / 2) > 1)
          
        } else {
            save = 0
            load = 1
            add_1 = (tick / 2) & 1
            add_2 = Int ((tick / 2) > 1)
        }
    }

    var offset = -1
    if save == 1 {
        offset = add_1 * 2 + add_2
    }

    var i = 0
    while i < 4 {
        var text = offset == i ? str(value) : str(.memory_state[i])
        ui_set_text(`states[{i + 1}][1]`, text)
        i += 1
    }

    var text_value = `{value}`
    if text_value.len() < 3 {
        text_value = " " + text_value
    }
    if text_value.len() < 3 {
        text_value = text_value + " "
    }
    text_value = markup(text_value)
    ui_set_text("actions[1][2]", text_value)

    var text_add = str(add_1) + str(add_2)
    text_add = markup(text_add)
    ui_set_text("actions[1][3]", text_add)

    if load == 0 {
        ui_set_text("actions[3][1]", "[OFF]")
        ui_set_hidden("actions[3][2]", true)
        ui_set_hidden("actions[3][3]", true)
    } else {
        var text_state = `{.memory_state[add_1 * 2 + add_2]}`
        if text_state.len() < 3 {
            text_state = " " + text_state
        }
        if text_state.len() < 3 {
            text_state = text_state + " "
        }
        text_state = markup(text_state)
        ui_set_text("actions[3][1]", "[ON]")
        ui_set_text("actions[3][2]", `[right] Load {text_state} [/right]`)
        ui_set_text("actions[3][3]", `[left]from {text_add}[/left]`)
        ui_set_hidden("actions[3][2]", false)
        ui_set_hidden("actions[3][3]", false)
    }

    if save == 0 {
        ui_set_text("actions[4][1]", "[OFF]")
        ui_set_hidden("actions[4][2]", true)
        ui_set_hidden("actions[4][3]", true)
    } else {
        ui_set_text("actions[4][1]", "[ON]")
        ui_set_text("actions[4][2]", `[right] Save {text_value} [/right]`)
        ui_set_text("actions[4][3]", `[left]to {text_add}[/left]`)
        ui_set_hidden("actions[4][2]", false)
        ui_set_hidden("actions[4][3]", false)
    }

    return Input {
        load: U1 load,
        save: U1 save,
        address: U2 add_1 << 1 | U2 add_2,
        value: U8 value,
    }
}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    if input.load == 1 {

        if .memory_state[input.address] != Int output.output {

            if output.output_is_z {
                set_error(`Output was Z, but it should have been {.memory_state[input.address]}.`)
            } else {
                set_error(`Output was {output.output}, but it should have been {.memory_state[input.address]}.`)
            }

            return fail

        }

    } else {

        if !output.output_is_z {
            set_error(`Output should have been Z.`)
            return fail
        }

    }

    if tick == 0xfff {

        return win

    }

    if input.save == 1 {
        .memory_state[input.address] = Int input.value
    }

}
