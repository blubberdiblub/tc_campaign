

var seed = 1 + random(0xfffe)
var count = 0

def show_calculations(seed: Int) {
    
    var result = ((seed >> 13) ^ seed) & 0xffffffff
    ui_set_text("line_1", `({result}) temp1  = seed  xor (seed  lsr 13)`)
    result = ((result << 17) ^ result) & 0xffffffff
    ui_set_text("line_2", `({result}) temp2  = temp1 xor (temp1 lsl 17)`)
    result = ((result >> 5) ^ result) & 0xffffffff
    ui_set_text("line_3", `({result}) result = temp2 xor (temp2 lsr 5)`)

}

def arch_get_input(test: Int) Int {

    return .seed

}

def arch_check_output(test: Int, input: Int, output: Int) TestResult {

    let this_seed = .seed

    var result = ((this_seed >> 13) ^ this_seed) & 0xffffffff
    result = ((result << 17) ^ result) & 0xffffffff
    result = ((result >> 5) ^ result) & 0xffffffff

    if output != result {
    
        set_error(`下一个随机种子应为 {result} 而非 {output}。`)
        return fail
    
    }

    if .count == 64 {
        
        return win

    }
    .count += 1

    .seed = result
    show_calculations(result)

}

show_calculations(seed)
