var memory      = U8 0
var next_memory = U8 0

def get_padded_number(num: U8) String {
    var s = `{num}`
    if s.len() < 3 {
        s = " " + s
    }
    if s.len() < 3 {
        s = s + " "
    }
    return s
}

def get_input(tick: Int) Input {

    .memory = .next_memory

    var action = random(4)
    var num    = U8 random(0x100)

    if tick == 0 {
        action = 1
    }

    var save = 0

    if (action & 1) != 0 {

        save = 1
        .next_memory = num

    }

    var text = ""
    if save == 0 {
        text = "[F]"
    } else {
        text = "[T]"
    }
    ui_set_text("table[0][1]", text)
    ui_set_text("table[1][1]", `{get_padded_number(num)}`)

    return Input {save: U1 save, input: U8 num}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {
    ui_set_text("table[2][1]", `{get_padded_number(.memory)}`)

    if output.output_is_z {
        ui_set_text("table[3][1]", ` Z `)
        set_error((31337_70376380014778, `Output should never be Z state`))
        return fail
    }

    ui_set_text("table[3][1]", `{get_padded_number(output.output)}`)

    if output.output != .memory {
        let expected_output = .memory
        set_error((31337_60269032570207, `Expected output {expected_output}.`))
        return fail
    }

    if tick == 0xffff {
        return win
    }

}