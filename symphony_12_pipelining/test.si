
var instruction_1 = 0
var instruction_2 = 0
var instruction_3 = 0
var counter_1 = U32 0
var counter_2 = U32 0
var counter_3 = U32 0

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let actual_counter = get_load_port_input("Instruction")

    if U32 actual_counter != .counter_1 {

        ui_set_instruction(0, 0, 0)
        set_error(`You should have read address {.counter_1} from the Main Memory, not {val_str(actual_counter)}. You must have not updated the counter correctly last tick.`)
        return fail

    }

    .instruction_3 = .instruction_2
    .instruction_2 = .instruction_1
    .instruction_1 = Int get_ram_value("Main Memory", Int .counter_1, <U32>)

    ui_set_instruction(0, .instruction_1, Int .counter_1)
    ui_set_instruction(1, .instruction_2, Int .counter_2)
    ui_set_instruction(2, .instruction_3, Int .counter_3)

    if get_memory("Count 1") != Int .counter_1 {
        set_error(`"Count 1" should have value {.counter_1}, not {get_memory("Count 1")}`)
        return fail
    }

    if get_memory("Count 2") != Int .counter_2 {
        set_error(`"Count 2" should have value {.counter_2}, not {get_memory("Count 2")}`)
        return fail
    }

    let retire_counter = .counter_3
    .counter_3 = .counter_2
    .counter_2 = .counter_1

    let error = retire_instruction(.instruction_3, $.counter_1, retire_counter, inputs[0], (outputs[2] & 1) == 1, outputs[1])

    if error {

        return fail

    }

    if get_memory("Instr 1") != .instruction_1 {
        set_error(`"Instr 1" should have value {.instruction_1}, not {get_memory("Instr 1")}`)
        return fail
    }

    if get_memory("Instr 2") != .instruction_2 {
        set_error(`"Instr 2" should have value {.instruction_2}, not {get_memory("Instr 2")}`)
        return fail
    }

    if state_is_bad() {
        return fail

    }

    if tick > 0xfff {
        return win
    }

}



