const INSTRUCTION_A_0 = 0
const INSTRUCTION_A_1 = 1
const INSTRUCTION_A_2 = 2
const INSTRUCTION_B_0 = 3
const INSTRUCTION_B_1 = 4
const INSTRUCTION_B_2 = 5

const STALL_COUNT = INSTRUCTION_B_2 + 1

const KEYBOARD = STALL_COUNT + 1
const CONSOLE = KEYBOARD + 1

const REGS = CONSOLE + 1

const COUNTER_3 = REGS + 16
const COUNTER_2 = COUNTER_3 + 1
const COUNTER_1 = COUNTER_2 + 1
const COUNTER_0 = COUNTER_1 + 1

const IO_1 = COUNTER_0 + 1
const IO_2 = IO_1 + 1

const FLUSH_0 = IO_2 + 1
const FLUSH_1 = FLUSH_0 + 1
const FLUSH_2 = FLUSH_1 + 1

const TIMER_SNAPSHOT = FLUSH_2 + 1

const RAM = TIMER_SNAPSHOT + 1
const SSD = RAM + 0x10000

const #OP_IO  = 0
const #OP_ALU = 1
const #OP_JMP = 2
const #OP_RAM = 3

def timer(input: Bool, index: Int) Bool {

    let time = scratch_space[index]

    scratch_space[index] = max(0, time - 1)
    
    if time >= 1 { return true }

    if input {

        scratch_space[index] = 2

    }
    
}

def flag_result(a: Int, b: Int) Int {

    let equal = Int (a == b)
    let uless = Int (U16 a < U16 b) & 1
    let sless = Int (S16 a < S16 b) & 1

    return (sless << 2) | (uless << 1) | equal

}


def hazard_data(instruction_0: Int, instruction_1: Int) Bool {

    let mode_a        = (instruction_0 >> 29)
    let dest_a        = (instruction_0 >> 20) & 0b1111

    let mode_b        = (instruction_1 >> 29)
    let a             = (instruction_1 >> 16) & 0b1111
    let b             = (instruction_1 >> 8) & 0b1111
    let immediate     = (instruction_1 >> 28) & 1 != 0

    if mode_a == #OP_JMP {

        return false

    }

    if mode_b != #OP_ALU {

        return false

    }

    if dest_a != 0 {

        if dest_a == a {

            return false

        }

        if dest_a == b && !immediate {

            return false

        }

    }

    return true

}

def retire_instruction(instruction: Int, input: Int) Int {
    
    let mode            = (instruction >> 29) & 0b11
    let opcode          = (instruction >> 24) & 0b1111
    let dest            = (instruction >> 20) & 0b1111
    let a               = (instruction >> 16) & 0b1111
    let b               = (instruction >> 8) & 0b1111
    let immediate       = (instruction >> 28) & 1 != 0
    let immediate_value =  instruction & 0xffff

    scratch_space[REGS + 0] = 0

    let a_value = scratch_space[REGS + a]
    let b_value = immediate ? immediate_value : scratch_space[REGS + b]

    def flag_result(a: Int, b: Int) Int {

        let equal = Int (a == b)
        let uless = Int (U16 a < U16 b) & 1
        let sless = Int (S16 a < S16 b) & 1

        return (sless << 2) | (uless << 1) | equal

    }

    switch mode

        #OP_IO {

            const NOP         = 0
            const IO_IN       = 1
            const IO_OUT      = 2
            const IO_KEYBOARD = 3
            const IO_TIME_0   = 4
            const IO_TIME_1   = 5
            const IO_TIME_2   = 6
            const IO_TIME_3   = 7
            const IO_COUNTER  = 8
            const IO_CONSOLE  = 9

            switch opcode
                IO_IN {

                    scratch_space[REGS + dest] = input

                }
                IO_OUT {

                    return b_value

                }
                IO_KEYBOARD {

                    scratch_space[REGS + dest] = scratch_space[KEYBOARD]

                }
                IO_TIME_0 {

                    scratch_space[TIMER_SNAPSHOT] = get_last_time()

                    scratch_space[REGS + dest] = scratch_space[TIMER_SNAPSHOT] & 0xffff

                }
                IO_TIME_1 {

                    scratch_space[REGS + dest] = (scratch_space[TIMER_SNAPSHOT] >> 16) & 0xffff

                }
                IO_TIME_2 {

                    scratch_space[REGS + dest] = (scratch_space[TIMER_SNAPSHOT] >> 32) & 0xffff

                }
                IO_TIME_3 {

                    scratch_space[REGS + dest] = (scratch_space[TIMER_SNAPSHOT] >> 48) & 0xffff

                }
                IO_CONSOLE {

                    scratch_space[CONSOLE] = b_value

                }
                IO_COUNTER {

                    scratch_space[REGS + dest] = scratch_space[COUNTER_3]

                }

        }

        #OP_ALU {

            var result = 0

            switch opcode
                0 {
                    result = ~(a_value & b_value)
                }
                1 {
                    result = a_value | b_value
                }
                2 { 
                    result = a_value & b_value
                }
                3 { 
                    result = ~(a_value | b_value)
                }
                4 { 
                    result = a_value + b_value
                }
                5 { 
                    result = a_value - b_value
                }
                6 { 
                    result = a_value ^ b_value
                }
                7 { 
                    result = a_value << b_value
                }
                8 { 
                    result = a_value >> b_value
                }
                9 { 
                    result = flag_result(a_value, b_value)
                }

            scratch_space[REGS + dest] = result & 0xffff

        }

        #OP_JMP {

            let flags   = a_value & 0b111
            let matched = (opcode & flags) > 0
            let met     = matched != ((opcode & 0b1000) > 0)

            if met {

                scratch_space[COUNTER_0] = b_value
                scratch_space[FLUSH_0] = 1

            }

        }

        #OP_RAM {

            const LOAD_8    = 0
            const STORE_8   = 1
            const LOAD_16   = 2
            const STORE_16  = 3
            const PLOAD_8   = 4
            const PSTORE_8  = 5
            const PLOAD_16  = 6
            const PSTORE_16 = 7

            switch opcode

                LOAD_8 {

                    scratch_space[REGS + dest] = scratch_space[RAM + b_value]

                }

                STORE_8 {

                    scratch_space[RAM + b_value + 0] = a_value & 0xff

                }

                LOAD_16 {

                    var value = scratch_space[RAM + b_value] << 8 + scratch_space[RAM + b_value + 1]
                    scratch_space[REGS + dest] = value

                }

                STORE_16 {

                    scratch_space[RAM + b_value + 1] = a_value & 0xff
                    scratch_space[RAM + b_value + 0] = a_value >> 8

                }

                PLOAD_8 {

                    scratch_space[REGS + dest] = scratch_space[SSD + b_value]

                }

                PSTORE_8 {

                    scratch_space[SSD + b_value + 0] = a_value & 0xff

                }

                PLOAD_16 {

                    var value = scratch_space[SSD + b_value] << 8 + scratch_space[SSD + b_value + 1]
                    scratch_space[REGS + dest] = value

                }

                PSTORE_16 {

                    scratch_space[SSD + b_value + 1] = a_value & 0xff
                    scratch_space[SSD + b_value + 0] = a_value >> 8

                }


        }


    scratch_space[REGS + 0] = 0

    return #Z_STATE

}

def val_str(input: Int) String {
    
    if input == #Z_STATE { return "Z" }

    return str(input)

}

var addr = 0
while addr < 0xfffe {

    scratch_space[RAM + addr] = get_ram_value("Main Memory", addr, <U8>)
    scratch_space[SSD + addr] = get_ram_value("Main Memory", addr, <U8>)
    addr += 1

}

def get_input(tick: Int) Input {

    let result = random(0xff)
    inputs[0] = result

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    // Update everything except counter

    let counter = get_load_port_input("PC")
    if counter != scratch_space[COUNTER_0] {

        ui_set_text("description", "???")
        set_error(`You should read address {scratch_space[COUNTER_0]} from the assembler, not {val_str(counter)}`)
        return fail

    }

    scratch_space[COUNTER_3] = scratch_space[COUNTER_2]
    scratch_space[COUNTER_2] = scratch_space[COUNTER_1]
    scratch_space[COUNTER_1] = scratch_space[COUNTER_0]

    let output = get_ram_value("Main Memory", counter, <U32>)

    scratch_space[INSTRUCTION_A_2] = scratch_space[INSTRUCTION_A_1]
    scratch_space[INSTRUCTION_A_1] = scratch_space[INSTRUCTION_A_0]
    scratch_space[INSTRUCTION_A_0] = output >> 32

    scratch_space[INSTRUCTION_B_2] = scratch_space[INSTRUCTION_B_1]
    scratch_space[INSTRUCTION_B_1] = scratch_space[INSTRUCTION_B_0]
    scratch_space[INSTRUCTION_B_0] = output & 0xffffffff

    scratch_space[FLUSH_2] = scratch_space[FLUSH_1] | scratch_space[FLUSH_0]
    scratch_space[FLUSH_1] = scratch_space[FLUSH_0]
    scratch_space[FLUSH_0] = 0

    scratch_space[IO_2] = scratch_space[IO_1]
    scratch_space[IO_1] = inputs[0]

    ui_set_text("instruction_a_0", `[left]{instruction_to_str(scratch_space[INSTRUCTION_A_0])}[/left]`)
    ui_set_text("instruction_a_1", `[left]{instruction_to_str(scratch_space[INSTRUCTION_A_1])}[/left]`)
    ui_set_text("instruction_a_2", `[left]{instruction_to_str(scratch_space[INSTRUCTION_A_2])}[/left]`)

    ui_set_text("instruction_b_0", `[left]{instruction_to_str(scratch_space[INSTRUCTION_B_0])}[/left]`)
    ui_set_text("instruction_b_1", `[left]{instruction_to_str(scratch_space[INSTRUCTION_B_1])}[/left]`)
    ui_set_text("instruction_b_2", `[left]{instruction_to_str(scratch_space[INSTRUCTION_B_2])}[/left]`)

    let instruction_a = scratch_space[INSTRUCTION_A_0]
    let instruction_b = scratch_space[INSTRUCTION_B_0]

    let stall       = timer(instruction_a >> 29 == #OP_JMP, $scratch_space, STALL_COUNT)
    let data_hazard = hazard_data(instruction_a, instruction_b)

    let enable_a = true
    let enable_b = data_hazard

    if enable_a {

        scratch_space[COUNTER_0] = (scratch_space[COUNTER_0] + 4) & 0xffff

    } else {

        scratch_space[INSTRUCTION_A_0] = 0

    }

    if enable_b {

        scratch_space[COUNTER_0] = (scratch_space[COUNTER_0] + 4) & 0xffff

    } else {

        scratch_space[INSTRUCTION_B_0] = 0

    }

    if scratch_space[FLUSH_2] == 1 {

        scratch_space[INSTRUCTION_A_2] = 0
        scratch_space[INSTRUCTION_B_2] = 0

    }


    // Retire instructions

    let correct_output = retire_instruction(scratch_space[INSTRUCTION_A_2], $scratch_space, inputs[0])
    retire_instruction(scratch_space[INSTRUCTION_B_2], $scratch_space, 0)

    if correct_output != #Z_STATE && outputs[1] != correct_output {

        set_error(`Output should be {correct_output}.`)
        return fail

    }

    var reg = 1
    while reg < 16 {

        let value = get_ram_value("Register file", reg * 4, <U32>)

        if value != scratch_space[REGS + reg] {

            var register = ""
            switch reg
                14 { register = "'sp'" }
                15 { register = "'flags'" }
                default { register = `r{reg}`}

            set_error(`{register} (RAM offset {reg * 4}) should have value {scratch_space[REGS + reg]}, not {val_str(value)}`)
            return fail

        }

        reg += 1

    }
    
    var addr = 0
    while addr < 0xfffe {

        let value = get_ram_value("Main Memory", addr, <U8>)

        if value != scratch_space[RAM + addr] {

            set_error(`Memory should contain value {scratch_space[RAM + addr]}, at address {addr}, not {val_str(value)}.`)
            return fail

        }

        addr += 1

    }

    // Check pipeline values, (do this after updating registers)

    {

        if scratch_space[INSTRUCTION_A_0] != get_memory("INSTR") {


            set_error(`The "INSTR" delay line should contain the last instruction: {scratch_space[INSTRUCTION_A_0]}.`)
            return fail

        }

        if scratch_space[INSTRUCTION_B_0] != get_memory("INSTR 2") {

            if scratch_space[INSTRUCTION_B_0] == 0 {

                set_error(`The second instruction should be disabled, so "INSTR 2" should contain 0.`)

            } else {
            
                set_error(`The "INSTR 2" delay line should contain the last instruction: {scratch_space[INSTRUCTION_B_0]}.`)

            }

            return fail

        }

    }

    {

        {

            if scratch_space[COUNTER_1] != get_memory("COUNTER 1") {

                set_error(`The "COUNTER 1" delay line should contain value {scratch_space[COUNTER_1]}, not {val_str(get_memory("COUNTER 1"))}.`)
                return fail

            }

            let instruction = scratch_space[INSTRUCTION_A_1]

            let mode            = (instruction >> 29) & 0b11
            let opcode          = (instruction >> 24) & 0b1111
            let dest            = (instruction >> 20) & 0b1111
            let a               = (instruction >> 16) & 0b1111
            let b               = (instruction >> 8)  & 0b1111
            let immediate       = (instruction >> 28) & 1 != 0
            let immediate_value =  instruction & 0xffff

            let a_value = scratch_space[REGS + a]
            let b_value = immediate ? immediate_value : scratch_space[REGS + b]

            if mode != get_memory("MODE") {

                set_error(`The "MODE A" delay line should contain value {mode}, not {val_str(get_memory("MODE"))}`)
                return fail

            }

            if opcode != get_memory("OPCODE") {

                set_error(`The "OPCODE A" delay line should contain value {opcode}, not {val_str(get_memory("OPCODE"))}`)
                return fail

            }

            if dest != get_memory("DEST") {

                set_error(`The "DEST" delay line should contain value {dest}, not {val_str(get_memory("DEST"))}`)
                return fail

            }

            if a_value != get_memory("ARG_A") {

                set_error(`The "ARG_A" delay line should contain value {a_value & 0xffff}, not {val_str(get_memory("ARG_A"))}`)
                return fail

            }

            if b_value != get_memory("ARG_B") {

                set_error(`The "ARG_B" delay line should contain value {b_value & 0xffff}, not {val_str(get_memory("ARG_B"))}`)
                return fail

            }

        }

        {

            let instruction = scratch_space[INSTRUCTION_B_1]

            let mode            = (instruction >> 29) & 0b11
            let opcode          = (instruction >> 24) & 0b1111
            let dest            = (instruction >> 20) & 0b1111
            let a               = (instruction >> 16) & 0b1111
            let b               = (instruction >> 8)  & 0b1111
            let immediate       = (instruction >> 28) & 1 != 0
            let immediate_value =  instruction & 0xffff

            let a_value = scratch_space[REGS + a]
            let b_value = immediate ? immediate_value : scratch_space[REGS + b]

            if dest != get_memory("DEST 2") {

                set_error(`The "DEST 2" delay line should contain value {dest}, not {val_str(get_memory("DEST 2"))}`)
                return fail

            }

            if a_value != get_memory("ARG_A 2") {

                set_error(`The "ARG_A 2" delay line should contain value {a_value & 0xffff}, not {val_str(get_memory("ARG_A 2"))}`)
                return fail

            }

            if b_value != get_memory("ARG_B 2") {

                set_error(`The "ARG_B 2" delay line should contain value {b_value & 0xffff}, not {val_str(get_memory("ARG_B 2"))}`)
                return fail

            }

        }

    }

    if tick == 2000 {

        return win

    }

}






