
const #OP_IO  = 0
const #OP_ALU = 1
const #OP_JMP = 2
const #OP_RAM = 3

const #MAX_RAM = U32 1 << 24
const #MAX_SSD = U32 1000

var counter   = U32 0
var registers = array(<U32>, 16)
var ram       = array(<U8>, #MAX_RAM)
var ssd       = array(<U8>, #MAX_SSD)
var saved_time = 0
var screen_setting = array(<Int>, 8)
screen_setting[2] = 16777200

var keypresses = [0x164, 0x064, 0x161, 0x061]
var keypress_index = 0

{

    var i = 0

    while i < keypresses.len() {

        add_keyboard_value(Bool (keypresses[i] >> 8), U8 keypresses[i])

        i += 1

    }

}

{
    // Copy assembled code to RAM

    var i = 0

    while i < ram.len() {

        let byte = get_ram_value("Main Memory", i, <U8>)
        ram[i] = byte
        i += 1

    }

}

def flag_result(a: U32, b: U32) U32 {

    let equal = U32 (a == b)
    let uless = U32 (U32 a < U32 b) & 1
    let sless = U32 (S32 a < S32 b) & 1

    return (sless << 2) | (uless << 1) | equal

}

def retire_instruction(instruction: Int, input: Int, output_enabled: Bool, output_value: Int) Bool {

    let mode            = (instruction >> 29) & 0b11
    let opcode          = (instruction >> 24) & 0b1111
    let dest            = (instruction >> 20) & 0b1111
    let a               = (instruction >> 16) & 0b1111
    let b               = (instruction >> 8) & 0b1111
    let immediate       = (instruction >> 28) & 1 != 0
    let immediate_value =  U32 (instruction & 0xffff)

    let a_value = .registers[a]
    let b_value = immediate ? immediate_value : .registers[b]

    switch mode

        #OP_IO {

            const #NOP      = 0
            const #INPUT    = 1
            const #OUTPUT   = 2
            const #KEYBOARD = 3
            const #SCREEN   = 4
            const #TIME_0   = 5
            const #TIME_1   = 6
            const #COUNTER  = 7

            switch opcode & 0xf
                #INPUT    { .registers[dest] = U32 input }
                #OUTPUT   { 
                    let expected_output = Int b_value

                    if !output_enabled {

                        set_error(`Output should have been enabled.`)
                        return true
                    }

                    if output_value != expected_output {

                        set_error(`Output should have been {expected_output}, not {output_value}.`)
                        return true

                    }

                }
                #KEYBOARD { 
                    if .keypress_index < .keypresses.len() {
                        .registers[dest] = U32 .keypresses[.keypress_index]
                        .keypress_index += 1
                    } else {
                        .registers[dest] = 0
                    }
                }
                #SCREEN   { .screen_setting[a_value] = Int b_value }
                #TIME_0   {
                    .saved_time = get_last_time()
                    .registers[dest] = U32 .saved_time
                }
                #TIME_1   {
                    .registers[dest] = U32 (.saved_time >> 32)

                    if .registers[dest] != U32 get_ram_value("Register File", dest * 4, <U32>) {
                        set_error(`Wrong time output (did you remember to cache the time on the time_0 instruction?)`)
                        return true
                    }
                }
                #COUNTER  { .registers[dest] = .counter }

            .counter += 4

        }

        #OP_ALU {

            .counter += 4

            var result = U32 0

            switch opcode
                0  { result = ~(a_value &  b_value) }
                1  { result =   a_value |  b_value }
                2  { result =   a_value &  b_value } 
                3  { result = ~(a_value |  b_value) } 
                4  { result =   a_value +  b_value } 
                5  { result =   a_value -  b_value }
                6  { result =   a_value ^  b_value }
                7  { result =   a_value << b_value }
                8  { result =   a_value >> b_value }
                9  { result =  U32 asr(S32 a_value, S32 b_value) }
                10 { result =  flag_result(a_value, b_value) }

            .registers[dest] = result & 0xffff_ffff

        }

        #OP_JMP {

            let flags   = Int a_value & 0b111
            let matched = (opcode & flags) > 0
            let met     = matched != ((opcode & 0b1000) > 0)

            if met {
                
                .counter = b_value

            } else {

                .counter += 4

            }

        }

        #OP_RAM {
            .counter += 4

            const #LOAD_8    = 0b0000
            const #LOAD_16   = 0b0001
            const #LOAD_32   = 0b0010
            const #PLOAD     = 0b0011
            const #STORE_8   = 0b0100
            const #STORE_16  = 0b0101
            const #STORE_32  = 0b0110
            const #PSTORE    = 0b0111

            const #RAM_MASK = #MAX_RAM - 1

            switch opcode

                #LOAD_8{

                    .registers[dest] = U32 .ram[b_value & #RAM_MASK]

                }

                #LOAD_16 {

                    .registers[dest] = (U32 .ram[b_value & #RAM_MASK] << 8) | (U32 .ram[(b_value + 1) & #RAM_MASK])

                }

                #LOAD_32 {

                    .registers[dest] = (U32 .ram[b_value  & #RAM_MASK] << 24) | (U32 .ram[(b_value + 1) & #RAM_MASK] << 16) | (U32 .ram[(b_value + 2) & #RAM_MASK] << 8) | (U32 .ram[(b_value + 3) & #RAM_MASK])

                }

                #STORE_8 {

                    .ram[b_value & #RAM_MASK] = U8 a_value

                }

                #STORE_16 {

                    .ram[(b_value + 1) & #RAM_MASK] = U8 a_value
                    .ram[(b_value + 0) & #RAM_MASK] = U8 (a_value >> 8)

                }

                #STORE_32 {

                    .ram[(b_value + 3) & #RAM_MASK] = U8 a_value
                    .ram[(b_value + 2) & #RAM_MASK] = U8 (a_value >> 8)
                    .ram[(b_value + 1) & #RAM_MASK] = U8 (a_value >> 16)
                    .ram[(b_value + 0) & #RAM_MASK] = U8 (a_value >> 24)

                }

                #PLOAD {

                    .registers[dest] = (U32 .ssd[b_value] << 24) | (U32 .ssd[b_value + 1] << 16) | (U32 .ssd[b_value + 2] << 8) | (U32 .ssd[b_value + 3])

                }

                #PSTORE {

                    if b_value < #MAX_SSD - 4 {

                        .ssd[b_value + 3] = U8 a_value
                        .ssd[b_value + 2] = U8 (a_value >> 8)
                        .ssd[b_value + 1] = U8 (a_value >> 16)
                        .ssd[b_value + 0] = U8 (a_value >> 24)

                    }

                }


        }

    .registers[0] = 0

}

def get_input(tick: Int) Input { 

    if tick < 0xff {

        return Input {input: U32 random(0xff)}

    } else {

        return Input {input: U32 random(0xffff_ffff)}

    }

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    if get_screen_connection("screen") != "Main Memory" {
        set_error(`Connect the screen to the "Main Memory" component.`)
        return fail

    }

    let actual_counter = get_load_port_input("Instruction")

    if U32 actual_counter != .counter {

        ui_set_instruction(0, 0, 0)
        set_error(`You should have read address {.counter} from the Main Memory, not {actual_counter}. You must have not updated the counter correctly last tick.`)
        return fail

    }

    var instruction = get_ram_value("Main Memory", Int .counter, <U32>)
    ui_set_instruction(0, Int instruction, Int .counter)

    let error = retire_instruction(Int instruction, Int input.input, output.output_enabled, Int output.output)

    if error {

        return fail

    }

    {

        var reg = 0
        while reg < 16 {

            let value = U32 get_ram_value("Register File", reg * 4, <U32>)

            if value != .registers[reg] {

                if reg == 0 {

                    set_error(`The 'zr' register should always be zero (address 0 in the 'Register File').`)

                } else {

                    var register = ""
                    switch reg
                        14 { register = "'sp'" }
                        15 { register = "'flags'" }
                        default { register = `r{reg}`}

                    set_error(`{register} ('Register File' address {reg * 4}) should have hex value 0x{hex(8, Int .registers[reg])}, not 0x{hex(8, Int value)}`)

                }
                return fail

            }

            reg += 1

        }
    }


    {
        // Tests only use addresses between 10k and 11k to speed up simulation

        var i = 10000

        while i < 11000 {
            let value = get_ram_value("Main Memory", i, <U8>)
            if .ram[i] != value {
                set_error(`Main Memory address {i} is supposed to have value {.ram[i]}, not {value}`)
                return fail
            }
            i += 1
        }
    }

    {
        // Tests only the first 1k

        var i = 0

        while i < 1000 {
            let value = get_ram_value("Persistent Memory", i, <U8>)
            if .ssd[i] != value {
                set_error(`Persistent Memory address {i} is supposed to have value {.ssd[i]}, not {value}`)
                return fail
            }
            i += 1
        }
    }

    {

        var i = 0

        while i < .screen_setting.len() {

            let value = get_screen_settings("screen", i)
            if value != .screen_setting[i] {
                set_error(`Screen setting {i} is supposed to be {.screen_setting[i]}, not {value}`)
                return fail
            }

            i += 1

        }

    }

    if tick > 0x4ffff {
        return win
    }

}
