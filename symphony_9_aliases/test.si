
def get_input(cycle: Int) Input {

    return Input {input: U32 10}

}

def check_output(cycle: Int, input: Input, output: Output) TestResult {

    switch cycle
        0 {

            if get_ram_value("Register File", 1 * 4, <U32>) != 0x1235 {
                set_error((31337_44683006232656, `The first instruction should have moved hex value 0x1235 to r1.`))
                return fail
            }

        }
        1 {

            if get_ram_value("Register File", 2 * 4, <U32>) != 0xffffedcb {
                set_error((31337_83123414679662, `r2 should have had hex value 0xffffedcb.`))
                return fail
            }

        }
        2 {

            if get_ram_value("Register File", 3 * 4, <U32>) != 0x1234 {
                set_error((31337_67087756287234, `r3 should have had hex value 0x1234`))
                return fail
            }

            return win

        }

}