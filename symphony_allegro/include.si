
const #OP_IO  = 0
const #OP_ALU = 1
const #OP_JMP = 2
const #OP_RAM = 3

const #MAX_RAM = U32 11000
const #MAX_SSD = U32 1000

var registers = array(<U32>, 16)
var ram       = array(<U8>, #MAX_RAM)
var ssd       = array(<U8>, #MAX_SSD)
var saved_time = 0
var screen_setting = 0

add_keyboard_value(true, U8 0xff)

def flag_result(a: U32, b: U32) U32 {

    let equal = U32 (a == b)
    let uless = U32 (U32 a < U32 b) & 1
    let sless = U32 (S32 a < S32 b) & 1

    return (sless << 2) | (uless << 1) | equal

}

def retire_instruction(instruction: Int, $counter: U32, counter_3: U32, input: Int, output_enabled: Bool, output_value: Int) Bool {

    let mode            = (instruction >> 29) & 0b11
    let opcode          = (instruction >> 24) & 0b1111
    let dest            = (instruction >> 20) & 0b1111
    let a               = (instruction >> 16) & 0b1111
    let b               = (instruction >> 8) & 0b1111
    let immediate       = (instruction >> 28) & 1 != 0
    let immediate_value =  U32 (instruction & 0xffff)

    let a_value = .registers[a]
    let b_value = immediate ? immediate_value : .registers[b]

    switch mode

        #OP_IO {

            const #NOP      = 0
            const #INPUT    = 1
            const #OUTPUT   = 2
            const #KEYBOARD = 3
            const #SCREEN   = 4
            const #TIME_0   = 5
            const #TIME_1   = 6
            const #COUNTER  = 7

            switch opcode
                #INPUT    { .registers[dest] = U32 input }
                #OUTPUT   { 
                    let expected_output = Int b_value

                    if !output_enabled {

                        set_error(`Output should have been enabled.`)
                        return true
                    }

                    if output_value != expected_output {

                        set_error(`Output should have been {expected_output}, not {val_str(output_value)}.`)
                        return true

                    }

                }
                #KEYBOARD { .registers[dest] = 0x01ff }
                #SCREEN   { .screen_setting = Int b_value }
                #TIME_0   {
                    .saved_time = get_last_time()
                    .registers[dest] = U32 .saved_time
                }
                #TIME_1   {
                    if (.saved_time != get_last_time()) {
                        set_error(`The time component shouldn't have been enabled since the last time_0 instruction's execution!\nRead the level log to learn more (this is mentioned on the second page).`)
                        return true
                    } else {
                        .registers[dest] = U32 (.saved_time >> 32)
                    }
                }
                #COUNTER  { .registers[dest] = counter_3 }

            counter += 4

        }

        #OP_ALU {

            counter += 4

            var result = U32 0

            switch opcode
                0  { result = ~(a_value &  b_value) }
                1  { result =   a_value |  b_value }
                2  { result =   a_value &  b_value } 
                3  { result = ~(a_value |  b_value) } 
                4  { result =   a_value +  b_value } 
                5  { result =   a_value -  b_value }
                6  { result =   a_value ^  b_value }
                7  { result =   a_value << b_value }
                8  { result =   a_value >> b_value }
                9  { result =  U32 asr(S32 a_value, S32 b_value) }
                10 { result =  flag_result(a_value, b_value) }

            .registers[dest] = result & 0xffff_ffff

        }

        #OP_JMP {

            let flags   = Int a_value & 0b111
            let matched = (opcode & flags) > 0
            let met     = matched != ((opcode & 0b1000) > 0)

            if met {
                
                counter = b_value

            } else {

                counter += 4

            }

        }

        #OP_RAM {
            counter += 4

            const #LOAD_8    = 0b0000
            const #LOAD_16   = 0b0001
            const #LOAD_32   = 0b0010
            const #PLOAD     = 0b0011
            const #STORE_8   = 0b0100
            const #STORE_16  = 0b0101
            const #STORE_32  = 0b0110
            const #PSTORE    = 0b0111

            switch opcode

                #LOAD_8{

                    if b_value < #MAX_RAM - 1 {

                        .registers[dest] = U32 .ram[b_value]

                    }

                }

                #LOAD_16 {

                    if b_value < #MAX_RAM - 2 {

                        .registers[dest] = (U32 .ram[b_value] << 8) | (U32 .ram[b_value + 1])

                    }

                }

                #LOAD_32 {

                    if b_value < #MAX_RAM - 4 {
                        
                        .registers[dest] = (U32 .ram[b_value] << 24) | (U32 .ram[b_value + 1] << 16) | (U32 .ram[b_value + 2] << 8) | (U32 .ram[b_value + 3])

                    }

                }

                #STORE_8 {

                    if b_value < #MAX_RAM - 1 {

                        .ram[b_value + 0] = U8 a_value

                    }

                }

                #STORE_16 {

                    if b_value < #MAX_RAM - 2 {

                        .ram[b_value + 1] = U8 a_value
                        .ram[b_value + 0] = U8 (a_value >> 8)

                    }

                }

                #STORE_32 {

                    if b_value < #MAX_RAM - 4 {

                        .ram[b_value + 3] = U8 a_value
                        .ram[b_value + 2] = U8 (a_value >> 8)
                        .ram[b_value + 1] = U8 (a_value >> 16)
                        .ram[b_value + 0] = U8 (a_value >> 24)

                    }

                }

                #PLOAD {

                    if b_value < #MAX_SSD - 4 {

                        .registers[dest] = (U32 .ssd[b_value] << 24) | (U32 .ssd[b_value + 1] << 16) | (U32 .ssd[b_value + 2] << 8) | (U32 .ssd[b_value + 3])

                    }

                }

                #PSTORE {

                    if b_value < #MAX_SSD - 4 {

                        .ssd[b_value + 3] = U8 a_value
                        .ssd[b_value + 2] = U8 (a_value >> 8)
                        .ssd[b_value + 1] = U8 (a_value >> 16)
                        .ssd[b_value + 0] = U8 (a_value >> 24)

                    }

                }


        }

    .registers[0] = 0

}

def val_str(input: Int) String {
    
    if input == #Z_STATE { return "Z" }

    return str(input)

}

def get_input(tick: Int) Input { 

    if tick < 0xff {

        inputs[0] = random(0xff)

    } else {
    
        inputs[0] = random(0xffff_ffff)

    }

}

def state_is_bad() Bool {

    {

        var reg = 0
        while reg < 16 {

            let value = U32 get_ram_value("Register File", reg * 4, <U32>)

            if value != .registers[reg] {

                if reg == 0 {

                    set_error(`The 'zr' register should always be zero (address 0 in the 'Register File').`)

                } else {

                    var register = ""
                    switch reg
                        14 { register = "'sp'" }
                        15 { register = "'flags'" }
                        default { register = `r{reg}`}

                    set_error(`{register} ('Register File' address {reg * 4}) should have hex value 0x{hex(8, Int .registers[reg])}, not 0x{hex(8, Int value)}`)

                }
                return true

            }

            reg += 1

        }
    }


    {
        // Tests only use addresses between 10k and 11k to speed up simulation

        var i = 10000

        while i < 11000 {
            let value = get_ram_value("Main Memory", i, <U8>)
            if .ram[i] != value {
                set_error(`Main Memory address {i} is supposed to have value {.ram[i]}, not {value}`)
                return true
            }
            i += 1
        }
    }

    {
        // Tests only the first 1k

        var i = 0

        while i < 1000 {
            let value = get_ram_value("Persistent Memory", i, <U8>)
            if .ssd[i] != value {
                set_error(`Persistent Memory address {i} is supposed to have value {.ssd[i]}, not {value}`)
                return true
            }
            i += 1
        }
    }

    {

        let value = get_screen_settings("screen", 3)
        if value != .screen_setting {
            set_error(`Screen setting 3 is supposed to be {.screen_setting}, not {value}`)
            return true
        }

    }    
}

def get_reg_name(register: Int) String {

    switch register
        0 { return `zr` }
        1 { return `r1` }
        2 { return `r2` }
        3 { return `r3` }
        4 { return `r4` }
        5 { return `r5` }
        6 { return `r6` }
        7 { return `r7` }
        8 { return `r8` }
        9 { return `r9` }
        10 { return `r10` }
        11 { return `r11` }
        12 { return `r12` }
        13 { return `r13` }
        14 { return `sp` }
        15 { return `flags` }
    
}

def get_random_alu_instruction() Int {

    let opcode = random(10)
    let d_vec = random(16) << 20
    let a_vec = random(16) << 16
    let is_immediate = random(2) == 1
    let b_vec = is_immediate ? 1 << 28 | random(0xffff) : random(8) << 8

    if opcode == 9 {

        return #OP_ALU << 29 | opcode << 24 | 6 << 20 | a_vec | b_vec

    }

    return #OP_ALU << 29 | opcode << 24 | d_vec | a_vec | b_vec
    
}

def get_random_instruction() Int {

    var mode = random(4)

    let d_vec = random(16) << 20
    let a_vec = random(16) << 16
    let is_immediate = random(2) == 1
    let b_vec = is_immediate ? 1 << 28 | random(0xffff) : random(8) << 8

    switch mode

        #OP_IO {

            let opcode = random(3)

            switch opcode 
                0 { return 0 } // Nop
                1 { return #OP_IO << 29 | opcode << 24 | d_vec } // In
                2 { return #OP_IO << 29 | opcode << 24 | b_vec } // Out

        }

        #OP_ALU {

            return get_random_alu_instruction()

        }
        
        #OP_JMP {

            if random(10) == 0 {
                return 0b01001000000011110000000000000000 | a_vec
            }

            let bitvec = sample([0b01011000000011110000000000000000, 0b01010001000011110000000000000000, 0b01011001000011110000000000000000, 0b01010010000011110000000000000000, 0b01011010000011110000000000000000, 0b01010011000011110000000000000000, 0b01011011000011110000000000000000, 0b01010100000011110000000000000000, 0b01011100000011110000000000000000, 0b01010101000011110000000000000000, 0b01011101000011110000000000000000])

            return bitvec | random(0xffff)

        }

        #OP_RAM {

            let opcode = random(4)

            if random(2) == 0 { // Load
                return #OP_RAM << 29 | opcode << 24 | b_vec | d_vec
            } else {
                return #OP_RAM << 29 | opcode << 24 | a_vec | b_vec | 1 << 26
            }


        }

}
