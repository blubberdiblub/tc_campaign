def flag_result(a: U32, b: U32) U32 {
    let equal = U32 (a == b)
    let uless = U32 (U32 a < U32 b) & 1
    let sless = U32 (S32 a < S32 b) & 1

    let result = (sless << 2) | (uless << 1) | equal

    return (sless << 2) | (uless << 1) | equal
}

def get_input(tick: Int) Input {

    var code = random(11)
    var a = U32 0
    var b = U32 0

    if tick < 0xfff {

        a = U32 random(0x100)

        if code == 7 || code == 8 || code == 9 {

            b = U32 random(32)

        } else {

            b = U32 random(0x100)

        }

    } else {

        a = U32 random(0x10000_0000)

        if code == 7 || code == 8 || code == 9 {

            b = U32 random(32)

        } else {

            b = U32 random(0x10000_0000)

        }

    }

    switch code
        0 { 

            ui_set_text("description", `{a} NAND {b} = {U32 ~(a & b)}`)

        }
        1 { 

            ui_set_text("description", `{a} OR {b} = {a | b}`) 

        }
        2 { 

            ui_set_text("description", `{a} AND {b} = {a & b}`) 

        }
        3 { 

            ui_set_text("description", `{a} NOR {b} = {U32 ~(a | b)}`) 

        }
        4 { 

            ui_set_text("description", `{a} ADD {b} = {U32 (a + b)}`) 

        }
        5 { 

            ui_set_text("description", `{a} SUB {b} = {a - b}`) 

        }
        6 { 

            ui_set_text("description", `{a} XOR {b} = {a ^ b}`) 

        }
        7 { 

            ui_set_text("description", `{a} LSL {b} = {U32 (a << b)}`) 

        }
        8 { 

            ui_set_text("description", `{a} LSR {b} = {a >> b}`) 

        }
        9 { 

            ui_set_text("description", `{a} ASR {b} = {asr(a, b)}`) 

        }
        10 { 

            ui_set_text("description", `CMP {a}, {b} = {flag_result(a, b)}`) 

        }

    return Input {opcode: U4 code, argument_a: U32 a, argument_b: U32 b}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    var result = U32 0

    switch input.opcode
        0  { result = ~(input.argument_a &  input.argument_b) }
        1  { result =   input.argument_a |  input.argument_b }
        2  { result =   input.argument_a &  input.argument_b } 
        3  { result = ~(input.argument_a |  input.argument_b) } 
        4  { result =   input.argument_a +  input.argument_b } 
        5  { result =   input.argument_a -  input.argument_b }
        6  { result =   input.argument_a ^  input.argument_b }
        7  { result =   input.argument_a << input.argument_b }
        8  { result =   input.argument_a >> input.argument_b }
        9  { result =   asr(input.argument_a, input.argument_b) }
        10 { result =   flag_result(input.argument_a, input.argument_b) }

    result &= 0xffff_ffff

    if output.result != result {
        return fail

    }

    if tick == 0xffff {

        return win

    }

}