
def get_input(tick: Int) Input {

    if random(2) == 0 {
        let value = U32 random(0x10000_0000)
        return Input {argument_a: value, argument_b: value}
    } else {
        return Input {argument_a: U32 random(0x10000_0000), argument_b: U32 random(0x10000_0000)}
    }


}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let equal = Int (input.argument_a == input.argument_b)
    let uless = Int (U32 input.argument_a < U32 input.argument_b) & 1
    let sless = Int (S32 input.argument_a < S32 input.argument_b) & 1

    let result = (sless << 2) | (uless << 1) | equal

    if Int output.result != result {
        let a = U1 sless
        let b = U1 uless
        let c = U1 equal
        set_error((31337_55730459238598, `Expected output: {a}{b}{c}.`))
        return fail

    }

    if tick == 0xffff {

        return win

    }

}
