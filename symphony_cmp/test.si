
def get_input(cycle: Int) Input {

    switch random(5)
        0 {
            let value = U32 random(0x10000_0000)
            return Input {argument_a: value, argument_b: value}
        }
        1 {
            let value = U32 random(0x10000_0000)
            return Input {argument_a: U32 value, argument_b: U32 value + 1}
        }
        2 {
            let value = U32 random(0x10000_0000)
            return Input {argument_a: U32 value + 1, argument_b: U32 value}
        }
        3 {
            return Input {argument_a: U32 random(0x10000_0000), argument_b: U32 random(0x10000_0000)}
        }
        4 {
            let value = U32 random(0x10000_0000)
            let mask = U32 1 << U32 random(32)
            return Input {argument_a: value, argument_b: value ^ mask}
        }

}

def check_output(cycle: Int, input: Input, output: Output) TestResult {

    if output.result_is_z {
        set_error((31337_33181499064044, `Result should never be Z state`))
        return fail
    }

    let equal = Int (input.argument_a == input.argument_b)
    let uless = Int (U32 input.argument_a < U32 input.argument_b) & 1
    let sless = Int (S32 input.argument_a < S32 input.argument_b) & 1

    let result = (sless << 2) | (uless << 1) | equal

    if Int output.result != result {
        let a = U1 sless
        let b = U1 uless
        let c = U1 equal
        set_error((31337_55730459238598, `Expected output: {a}{b}{c}.`))
        return fail

    }

    if cycle == 1_000_000 {

        return win

    }

}
