
var memory = U32 0
var next_memory = U32 0


def get_input(tick: Int) Input {

    .memory = .next_memory

    let store = random(2)
    let value = random(0x10000_0000)

    if store == 1 {
        .next_memory = U32 value
    } else {
        .next_memory += 4
    }

    return Input {overwrite: U1 store, value: U32 value}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let memory_value = get_memory("Count")

    if memory_value != Int .next_memory {

        set_error(`Memory is supposed to be {.next_memory}, not {memory_value}`)
        return fail

    }

    if output.output_is_z {

        set_error(`Output should never be Z`)
        return fail

    }

    if U32 output.output != .memory {

        set_error(`Output should be {.memory}`)
        return fail

    }

    if tick == 0xffff {

        return win

    }

}