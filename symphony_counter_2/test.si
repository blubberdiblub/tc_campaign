
var counter_value = U32 0


def get_input(tick: Int) Input {

    return Input {
        overwrite: random(<U1>), 
        value: random(<U32>), 
        hold: random(<U1>),
    }

}


def check_output(tick: Int, input: Input, output: Output) TestResult {

    if output.output_is_z {

        set_error(`Output should never be Z`)
        return fail

    }

    if output.output != .counter_value {

        set_error(`Output should be {.counter_value}`)
        return fail

    }

    if input.overwrite == 0 {
        if input.hold == 0 {

            .counter_value += 4

        }

    } else {

        .counter_value = input.value

    }

    if U32 get_memory("Count") != .counter_value {

        set_error(`Internal counter value should be {.counter_value}, not {get_memory("Counts")}`)
        return fail

    }


    if tick == 0xffff {

        return win

    }
}