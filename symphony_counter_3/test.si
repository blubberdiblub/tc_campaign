
var memory = 0


def get_input(tick: Int) Input {

    let store = random(2)
    let value = random(0xfff) << 2
    let inc   = random(3)

    inputs[0] = store
    inputs[1] = value
    inputs[2] = inc

}


def check_output(tick: Int, input: Input, output: Output) TestResult {

    if outputs[0] == #Z_STATE {

        set_error(`Output should never be Z`)
        return fail

    }

    if outputs[0] != .memory {

        set_error(`Output should be {.memory}`)
        return fail

    }

    if inputs[0] == 1 {

        .memory = inputs[1]

    } else {

        .memory += inputs[2] * 4

    }

    if get_memory("Count") != .memory {

        let memory_value = get_memory("Count")

        if memory_value == #Z_STATE {

            set_error(`Link the memory probe to a component`)
            return fail

        }

        set_error(`Counter value is supposed to be {.memory}, not {get_memory("Count")}`)
        return fail

    }

    if tick == 0xffff {

        return win

    }

}