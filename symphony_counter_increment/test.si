
def get_input(tick: Int) Input {

    inputs[0] = random(3)
    inputs[1] = random(0xfff) << 2

    if tick == 0 {

        inputs[1] = 4

    }

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let correct_output = inputs[1] + inputs[0] * 4

    if outputs[0] != correct_output {

        set_error(`{inputs[1]} + {inputs[0]} * 4 is {correct_output}, not {handle_z(outputs[0])}.`)
        return fail

    }


    if tick == 0xffff {

        return win
    
    }

}