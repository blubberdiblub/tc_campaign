def get_input(tick: Int) Input {

    return Input {instruction: U32 random(0xffffffff)}

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let instruction     =  Int input.instruction
    let mode            = (instruction >> 29) & 0b11
    let opcode          = (instruction >> 24) & 0b1111
    let dest            = (instruction >> 20) & 0b1111
    let a               = (instruction >> 16) & 0b1111
    let b               = (instruction >>  8) & 0b1111
    let immediate       = (instruction >> 28) & 1
    let immediate_value =  instruction & 0xffff

    if Int output.mode != mode {

        set_error(`Mode should be {mode}.`)
        return fail

    }

    if Int output.opcode != opcode {

        set_error(`Opcode should be {opcode}, not {output.opcode}.`)
        return fail

    }

    if Int output.destination != dest {

        set_error(`Destination should be {dest}.`)
        return fail

    }

    if Int output.argument_a != a {

        set_error(`Arg A should be {a}.`)
        return fail

    }

    if Int output.argument_b != b {

        set_error(`Arg B should be {b}.`)
        return fail

    }

    if Int output.is_immediate != immediate {

        set_error(`'Is immediate' should be {immediate}.`)
        return fail

    }

    if Int output.immediate_value != immediate_value {

        set_error(`Immediate value should be {immediate_value}.`)
        return fail

    }

    if tick == 0xffff {

        return win

    }

}