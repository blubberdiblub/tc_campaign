def flag_result(a: Int, b: Int) Int {
    let equal = Int (a == b)
    let uless = Int (U32 a < U32 b) & 1
    let sless = Int (S32 a < S32 b) & 1

    let result = (sless << 2) | (uless << 1) | equal

    return (sless << 2) | (uless << 1) | equal
}

def get_input(tick: Int) Input {

    var code = random(11)
    var a = 0
    var b = 0

    if tick < 0xfff {

        a = random(0x100)

        if code == 7 || code == 8 || code == 9 {

            b = random(32)

        } else {

            b = random(0x100)

        }

    } else {

        a = random(0x10000_0000)

        if code == 7 || code == 8 || code == 9 {

            b = random(32)

        } else {

            b = random(0x10000_0000)

        }

    }

    inputs[0] = code
    inputs[1] = a
    inputs[2] = b

    switch code
        0 { 

            ui_set_text("description", `{a} NAND {b} = {U32 ~(a & b)}`)

        }
        1 { 

            ui_set_text("description", `{a} OR {b} = {a | b}`) 

        }
        2 { 

            ui_set_text("description", `{a} AND {b} = {a & b}`) 

        }
        3 { 

            ui_set_text("description", `{a} NOR {b} = {U32 ~(a | b)}`) 

        }
        4 { 

            ui_set_text("description", `{a} ADD {b} = {U32 (a + b)}`) 

        }
        5 { 

            ui_set_text("description", `{a} SUB {b} = {a - b}`) 

        }
        6 { 

            ui_set_text("description", `{a} XOR {b} = {a ^ b}`) 

        }
        7 { 

            ui_set_text("description", `{a} LSL {b} = {U32 (a << b)}`) 

        }
        8 { 

            ui_set_text("description", `{a} LSR {b} = {a >> b}`) 

        }
        9 { 

            ui_set_text("description", `{a} ASR {b} = {asr(a, b)}`) 

        }
        10 { 

            ui_set_text("description", `FLAGS {a}, {b} = {flag_result(a, b)}`) 

        }
}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    var result = 0

    switch inputs[0]
        0  { result = ~(inputs[1] &  inputs[2]) }
        1  { result =   inputs[1] |  inputs[2] }
        2  { result =   inputs[1] &  inputs[2] } 
        3  { result = ~(inputs[1] |  inputs[2]) } 
        4  { result =   inputs[1] +  inputs[2] } 
        5  { result =   inputs[1] -  inputs[2] }
        6  { result =   inputs[1] ^  inputs[2] }
        7  { result =   inputs[1] << inputs[2] }
        8  { result =   inputs[1] >> inputs[2] }
        9  { result = Int asr(S32 inputs[1], S32 inputs[2]) }
        10 { result =  flag_result(inputs[1], inputs[2]) }

    result &= 0xffff_ffff

    if outputs[0] != result {
        return fail

    }

    if tick == 0xffff {

        return win

    }

}


