

def get_input(tick: Int) Input {

    var instruction_0 = 0
    var instruction_1 = 0

    if random(2) == 0 {
        instruction_0 = get_random_instruction()
    } else {
        instruction_0 = get_random_alu_instruction()
    }

    if random(2) == 0 {
        instruction_1 = get_random_instruction()
    } else {
        instruction_1 = get_random_alu_instruction()
    }

    ui_set_text("default", "")

    ui_set_instruction(0, instruction_0, 0)
    ui_set_instruction(1, instruction_1, 0)

    inputs[0] = instruction_0
    inputs[1] = instruction_1

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let instruction_0 = inputs[0]
    let mode_a        = (instruction_0 >> 29)
    let dest_a        = (instruction_0 >> 20) & 0b1111

    let instruction_1 = inputs[1]
    let mode_b        = (instruction_1 >> 29)
    let a             = (instruction_1 >> 16) & 0b1111
    let b             = (instruction_1 >> 8) & 0b1111
    let immediate     = (instruction_1 >> 28) & 1 != 0

    let is_enabled = outputs[0] == 1
    var should_be_enabled = true

    if mode_a == #OP_JMP {

        should_be_enabled = false

        if is_enabled {

            set_error(`Only one instruction can execute, since instruction A is a JMP instruction.`)
            return fail

        }

    }

    if mode_b != #OP_ALU {

        should_be_enabled = false

        if is_enabled {

            set_error(`Only one instruction can execute, since instruction B isn't an ALU instruction.`)
            return fail

        }

    }

    if dest_a != 0 {

        if dest_a == a {

            should_be_enabled = false

            if is_enabled {

                set_error(`Only one instruction can execute, otherwise instruction B would read from register {get_reg_name(dest_a)} before instruction A had written to it.`)
                return fail

            }

        }

        if dest_a == b && !immediate {

            should_be_enabled = false

            if is_enabled {

                set_error(`Only one instruction can execute, otherwise instruction B would read from register {get_reg_name(dest_a)} before instruction A had written to it.`)
                return fail

            }

        }

    }


    if !is_enabled && should_be_enabled {

        set_error(`Both instructions can be executed in parallel.`)
        return fail

    }


    if tick == 0xffff {

        return win

    }

}