var hazard_count = 0
def hazard(input: Bool) Bool {

    .hazard_count = max(0, .hazard_count - 1)
    
    if .hazard_count >= 1 { return true }

    if input {

        .hazard_count = 3

    }
    
}

def get_input(tick: Int) Input {

    return Input {input: random(<U1>) }

}

def check_output(tick: Int, input: Input, output: Output) TestResult {

    let hazard_sensitive = hazard(input.input == 1)

    if Bool output.output != hazard_sensitive {

        set_error(`In progress should be {Int hazard_sensitive}.`)
        return fail

    }

    if tick == 0xffff {

        return win
    
    }

}

