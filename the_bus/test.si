
def get_input(tick: Int) Input {

    var in = random(2)
    var out = random(2)
    var val1 = 0
    var val2 = 0

    if in == 0 {

        val1 = random(256)

    } else {

        val2 = random(256)

    }

    ui_set_text("description", `Forward the value from {in == 0 ? "A" : "B"} to {out == 0 ? "X" : "Y"}`)

    return Input {
        input_select: U1 in, 
        a: U8 val1, 
        b: U8 val2, 
        output_select: U1 out,
    }

}


def check_output(tick: Int, input: Input, output: Output) TestResult {

    var val = U8 0

    if input.input_select == 0 {

        val = input.a

    } else {

        val = input.b

    }


    if input.output_select == 0 {

        if output.x != val { 

            set_error(`Output X should be {val}.`)
            return fail 

        }

        if !output.y_is_z { 

            set_error("Output Y should be Z.")
            return fail 

        }

    } else {

        if output.y != val { 

            set_error(`Output Y should be {val}.`)
            return fail 

        }

        if !output.x_is_z { 

            set_error("Output X should be Z.")
            return fail 

        }

    }

    if tick == 32 {

        return win

    }

}